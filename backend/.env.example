PORT=3001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TMDB_API_KEY=
REDIS_URL=redis://localhost:6379
# Local development: start PostgreSQL with docker compose up -d postgres.
DATABASE_URL=postgres://afterword:afterword-local-development@localhost:5433/afterword
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Run PostgreSQL locally or use the database service in docker compose.
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
# Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET=
# Use false for local HTTP, true when serving over HTTPS.
AUTH_COOKIE_SECURE=false
